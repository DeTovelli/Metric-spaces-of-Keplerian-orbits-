bat@echo off
chcp 65001 > nul
echo ===================================================
echo [1/2] Запуск математического расчета на Pascal...
echo ===================================================

:: Запуск исполняемого файла (предварительно скомпилированного)
if exist D_criteria.exe (
    D_criteria.exe
) else (
    echo Ошибка: Исполняемый файл D_criteria.exe не найден.
    echo Сначала скомпилируйте программу командной fpc D_criteria.pas
    pause
    exit /b
)

echo.
echo ===================================================
echo [2/2] Генерация графиков через Python...
echo ===================================================

:: Запуск Python-скрипта визуализации
if exist plot_metrics.py (
    python plot_metrics.py
) else (
    echo Предупреждение: Скрипт plot_metrics.py не найден в папке.
)

echo.
echo Расчет и визуализация успешно завершены!
pause